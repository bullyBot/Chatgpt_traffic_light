{
  "manifest_version": 3,
  "name": "ChatGPT 任务红绿灯",
  "version": "0.1.1",
  "description": "用红绿灯查看已打开的 ChatGPT 任务；需要处理或确认完成时发送桌面通知。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "notifications", "alarms", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "ChatGPT 任务红绿灯",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
